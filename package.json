{
  "name": "kv-wallet",
  "version": "0.0.0",
  "private": true,
  "license": "MPL-2.0",
  "type": "module",
  "engines": {
    "node": ">=26.8.2"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc --build && tsc -p packages/signer/tsconfig.test.json",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "budgets": "node scripts/check-budgets.mjs",
    "benchmark": "node scripts/benchmark-kdf.mjs",
    "clean": "rm -rf packages/*/dist packages/*/*.tsbuildinfo"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "typescript": "7.0.2"
  }
}
